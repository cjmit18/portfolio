{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "./worker.js",
	"compatibility_date": "2026-08-20",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	// Contact form notifications: each new message is emailed to CONTACT_TO through this SMTP mailbox.
	// Set the mailbox password as a secret: npx wrangler secret put SMTP_PASSWORD. Without it no email is sent.
	"vars": {
		"SMTP_USER": "noreply@terminuscli.com",
		"CONTACT_TO": "mymail@wayne-mitchell.com"
	},
	"d1_databases": [
		{
			"binding": "CONTACT_DB",
			"database_name": "wayne-mitchell-contact",
			"database_id": "ccc318ba-961e-4bc7-bd1e-db23d6ab0a26",
			"remote": true
		}
	]
}